# Your domain, e.g. chess.example.com. Point its DNS A record at the server first.
# Leave empty to serve on http://<server IP>.
DOMAIN=

# Ports on the server. Change them if something else already uses 80 or 443.
HTTP_PORT=80
HTTPS_PORT=443

# Behind a shared proxy that already owns 80/443 (see README), uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml
# SHARED_NETWORK=edge
