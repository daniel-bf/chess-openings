# DOMAIN comes from .env. A domain gets HTTPS automatically; without one the site is served on plain HTTP.
{$DOMAIN::80} {
	root * /srv
	encode gzip zstd
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
}
